{
  "openapi": "3.0.3",
  "info": {"title": "Hosted playground test", "version": "1.0.0"},
  "servers": [{"url": "https://jsonplaceholder.typicode.com"}],
  "paths": {
    "/posts/{id}": {
      "get": {
        "operationId": "getTestPost",
        "summary": "Get a test post",
        "description": "Send a request to JSONPlaceholder's public hosted test API. This checks playground request execution separately from the fictional bookstore schema and freshness tests. No local server or tunnel is required.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1, "maximum": 100}}],
        "responses": {
          "200": {"description": "A test post from JSONPlaceholder", "content": {"application/json": {"schema": {"type": "object", "required": ["userId", "id", "title", "body"], "properties": {"userId": {"type": "integer"}, "id": {"type": "integer"}, "title": {"type": "string"}, "body": {"type": "string"}}}}}}
        }
      }
    }
  }
}
