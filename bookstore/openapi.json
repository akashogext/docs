{
  "openapi": "3.0.3",
  "info": {"title": "Bookstore test API", "version": "1.0.0", "description": "Made-up API for Mintlify and Dosu tests. No live API server is provisioned yet."},
  "servers": [{"url": "https://handheld-herein-diffs-decor.trycloudflare.com", "description": "Temporary fictional API for the playground test"}],
  "paths": {
    "/books": {
      "get": {
        "operationId": "listBooks",
        "summary": "List books",
        "responses": {"200": {"description": "A list of books", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Book"}}}}}}
      }
    },
    "/books/{id}": {
      "get": {
        "operationId": "getBook",
        "summary": "Get a book",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}],
        "responses": {
          "200": {"description": "The requested book", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Book"}, "example": {"id": 1, "title": "The Sample Book", "author_name": "Alex Example"}}}},
          "404": {"description": "Book not found"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {"type": "object", "required": ["id", "title", "author_name"], "additionalProperties": false, "properties": {"id": {"type": "integer", "minimum": 1}, "title": {"type": "string"}, "author_name": {"type": "string"}}}
    }
  }
}
